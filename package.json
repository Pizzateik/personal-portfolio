{
  "name": "eik-rose-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/generate-images.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:worker": "npm run build && wrangler dev --local",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wrangler": "4.146.0"
  }
}
