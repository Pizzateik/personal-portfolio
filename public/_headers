# Vite fingerprints these files; new builds get new URLs.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Index the canonical domain, not Workers production/preview hostnames.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:preview.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
